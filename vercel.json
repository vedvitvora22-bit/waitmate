{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cleanup-ghosts",
      "schedule": "30 18 * * *"
    }
  ]
}
